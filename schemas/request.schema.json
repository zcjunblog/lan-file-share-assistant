{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAN File Share Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "file_paths", "ttl_seconds", "bind_address", "port", "host_context", "transport"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "file_paths": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "folder_mode": {"const": true},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
    "bind_address": {"type": ["string", "null"], "maxLength": 15},
    "port": {"oneOf": [{"const": 0}, {"type": "integer", "minimum": 1024, "maximum": 65535}]},
    "transport": {"const": "http"},
    "host_context": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "evidence"],
      "properties": {
        "kind": {"enum": ["local", "remote", "unknown"]},
        "evidence": {"enum": ["user_confirmed", "desktop_adapter", "none"]}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "local"}}}, "then": {"properties": {"evidence": {"enum": ["user_confirmed", "desktop_adapter"]}}}}]
    }
  },
  "if": {"required": ["folder_mode"]},
  "then": {"properties": {"file_paths": {"maxItems": 0}}},
  "else": {"properties": {"file_paths": {"minItems": 1}}}
}
