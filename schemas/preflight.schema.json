{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAN File Share Preflight Report 1.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "preflight_id", "request_digest", "checked_at", "valid_until", "result", "can_start", "can_publish", "checks", "receiver_status", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "preflight_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "request_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checked_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "result": {"enum": ["supported", "needs_action", "unsupported"]},
    "can_start": {"type": "boolean"},
    "can_publish": {"const": false},
    "receiver_status": {"const": "not_tested"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "reason_code", "summary", "evidence", "remediation"],
        "properties": {
          "id": {"enum": ["host_context", "runtime", "source_files", "workspace", "qr", "interface", "bind", "lifecycle"]},
          "elapsed_ms": {"type": "integer", "minimum": 0},
          "status": {"enum": ["pass", "fail", "unknown"]},
          "reason_code": {"type": "string", "pattern": "^[a-z_]+$"},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"enum": ["observed", "user_confirmed", "desktop_adapter", "not_tested", "fixture"]},
          "remediation": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [{"if": {"properties": {"status": {"enum": ["fail", "unknown"]}}}, "then": {"properties": {"remediation": {"minItems": 1}}}}]
      }
    }
  }
}
